{
  "name": "davros",
  "version": "0.0.0",
  "private": true,
  "description": "Personal file storage server",
  "repository": "",
  "license": "MIT",
  "author": "Michael Nutt <michael@nutt.im>",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel \"lint:!(fix)\"",
    "lint:fix": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "vite",
    "dev": "npm-run-all --parallel dev:api dev:ui",
    "dev:api": "SKIP_DIST_CHECK=1 PORT=8000 node app.js",
    "dev:ui": "vite --port=4200 --host=0.0.0.0",
    "test": "npm-run-all lint test:ember test:server",
    "test:ember": "vite build --mode development && ember test --path dist",
    "test:server": "vitest run --config vitest.server.config.mjs"
  },
  "dependencies": {
    "archiver": "^5.3.0",
    "async": "^3.2.1",
    "asyncjs": "https://github.com/mnutt/async.js.git#ad52b322176a88ef55c76052a9b3a8aa8bd6e083",
    "cache-require-paths": "0.3.0",
    "child-process-promise": "^2.2.1",
    "compression": "^1.8.1",
    "concat-files": "^0.1.1",
    "dirStat": "0.0.2",
    "duplexify": "^3.7.1",
    "express": "^5.1.0",
    "fs-extra": "^10.0.0",
    "image-size": "^1.0.0",
    "imagemagick-stream": "^4.1.1",
    "jsDAV": "https://github.com/mnutt/jsDAV.git#5dc07f7f47134bf51469306aa0af283e5e438590",
    "morgan": "^1.10.0",
    "multiparty": "^4.2.3",
    "sharp": "^0.34.5",
    "walker": "^1.0.8",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/runtime": "^7.28.6",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.4.1",
    "@embroider/compat": "^4.1.14",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.4.4",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.0",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.6.0",
    "@eslint/js": "^9.39.2",
    "@glimmer/component": "^2.0.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.21",
    "babel-plugin-ember-template-compilation": "^3.1.0",
    "broccoli-plugin": "^4.0.7",
    "date-fns": "^2.27.0",
    "decorator-transforms": "^2.3.1",
    "ember-cli": "^6.11.0",
    "ember-cli-babel": "^8.2.0",
    "ember-concurrency": "^5.2.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.2.0",
    "ember-source": "^6.11.0",
    "ember-template-lint": "^7.9.3",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-qunit": "^8.2.5",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-import": "^14.0.2",
    "pretender": "^3.4.7",
    "prettier": "^3.8.0",
    "prettier-plugin-ember-template-tag": "^2.1.2",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "showdown": "^2.1.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.18",
    "testem": "^3.17.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "xmldoc": "^1.1.2"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "ember": {
    "edition": "octane"
  },
  "volta": {
    "node": "24.13.0"
  },
  "ember-addon": {
    "paths": [
      "lib/testem-server-middleware"
    ]
  },
  "packageManager": "yarn@4.12.0",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  }
}
