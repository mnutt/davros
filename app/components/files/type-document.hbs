{{#if this.canSandbox}}
  {{#if this.needsCapability}}
    <div class="w-full h-full flex items-center justify-center text-center border-t p-4">
      <div>
        <p class="mb-3">Connect an office-to-PDF preview service to render this file.</p>
        {{#if this.capabilityErrorMessage}}
          <p class="mb-3 text-red-700">{{this.capabilityErrorMessage}}</p>
        {{/if}}
        <button
          type="button"
          class="btn btn-secondary border px-3 py-1"
          {{on "click" this.requestCapability}}
          disabled={{not this.canRequestCapability}}>
          {{if this.requestingCapability "Connecting..." "Enable Document Previews"}}
        </button>
      </div>
    </div>
  {{else if this.errored}}
    <div class="w-full h-full flex items-center justify-center text-center border-t">
      There was an error rendering this preview.
    </div>
  {{else}}
    <iframe
      class="w-full h-full border-t"
      title="Document Preview"
      src={{this.previewBlobUrl}}
      sandbox="allow-scripts allow-modals"
      referrerpolicy="no-referrer"
      loading="lazy"></iframe>
  {{/if}}
{{else}}
  <p>Your browser doesn't support sandboxing, so we can't show a preview inline.</p>
{{/if}}
