<span class="breadcrumb">
  <span class="full hidden sm:inline">
    <LinkTo @route="files" class="underline" {{on "click" (fn this.onClick "")}}>home</LinkTo>

    {{#each this.parts as |part|}}
      <span class="separator">/</span>
      <LinkTo @route="file" @model={{part.path}} class="underline" {{on "click" (fn this.onClick part.path)}}>{{part.name}}</LinkTo>
    {{/each}}

    /
  </span>

  <span class="parent-only inline sm:hidden">
    {{#if this.isHome}}
      <LinkTo @route="files" class="underline" {{on "click" (fn this.onClick "")}}>home</LinkTo>
    {{else}}
      {{#if (eq this.parentPath "")}}
        <LinkTo @route="files" class="underline" {{on "click" (fn this.onClick "")}}>...</LinkTo>
      {{else}}
        <LinkTo @route="file" @model={{this.parentPath}} class="underline" {{on "click" (fn this.onClick this.parentPath)}}>...</LinkTo>
      {{/if}}
    {{/if}}

    /
  </span>
</span>
